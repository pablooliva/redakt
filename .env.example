# Redakt configuration — copy to .env and uncomment any values you want to override.
# Defaults are defined in src/redakt/config.py. All vars use the REDAKT_ prefix.
# Complex types (dicts, lists) are JSON-encoded.

# --- Presidio services ---
# REDAKT_PRESIDIO_ANALYZER_URL=http://localhost:5001
# REDAKT_PRESIDIO_ANONYMIZER_URL=http://localhost:5001
# REDAKT_PRESIDIO_TIMEOUT=30.0

# --- Detection sensitivity ---
# Global score floor applied by Presidio. Lower = more recall, more false positives.
# REDAKT_DEFAULT_SCORE_THRESHOLD=0.35

# Per-entity floors applied as a post-filter on Presidio results.
# Raise an entity's floor to suppress borderline matches (e.g. "Munich", "today")
# without affecting other entity types. JSON map.
# REDAKT_ENTITY_SCORE_THRESHOLDS={"LOCATION": 0.90, "DATE_TIME": 0.95}

# --- Language ---
# REDAKT_DEFAULT_LANGUAGE=auto
# REDAKT_SUPPORTED_LANGUAGES=["en", "de"]
# REDAKT_LANGUAGE_DETECTION_TIMEOUT=2.0
# REDAKT_LANGUAGE_DETECTION_FALLBACK=en

# --- Allow list (instance-wide; merged with per-request terms) ---
# REDAKT_ALLOW_LIST=["Acme Corp", "ProductName"]

# --- Limits ---
# REDAKT_MAX_TEXT_LENGTH=512000
# REDAKT_MAX_FILE_SIZE=10485760
# REDAKT_MAX_ZIP_UNCOMPRESSED_SIZE=104857600
# REDAKT_MAX_CONCURRENT_UPLOADS=3
# REDAKT_MAX_XLSX_CELLS=50000
# REDAKT_DOCUMENT_PROCESSING_TIMEOUT=120.0
# REDAKT_SUPPORTED_FILE_TYPES=[".txt", ".md", ".csv", ".json", ".xml", ".html", ".xlsx", ".docx", ".rtf", ".pdf"]

# --- Logging ---
# REDAKT_LOG_LEVEL=WARNING

# --- Audit log ---
# REDAKT_AUDIT_LOG_FILE=
# REDAKT_AUDIT_LOG_MAX_BYTES=10485760
# REDAKT_AUDIT_LOG_BACKUP_COUNT=5
